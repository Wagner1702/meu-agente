# Copie para .env e preencha. NUNCA envie o .env para o GitHub (já está no .gitignore).

# Chave da API do Claude (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Login do ERP: o agente digita direto no campo; o Claude nunca vê esses valores.
ERP_USUARIO=
ERP_SENHA=

# Navegador: "msedge" ou "chrome" usa o que já está instalado no computador
# (dispensa o "playwright install chromium").
# AGENTE_NAVEGADOR_CANAL=msedge

# 1 = navegador sem janela visível
# AGENTE_NAVEGADOR_OCULTO=1

# 1 = ações no navegador rodam sem pedir aprovação
# AGENTE_AUTO_APROVAR_NAVEGADOR=1

# 1 = comandos só de leitura no terminal (ls, cat, dir...) rodam sem perguntar
# AGENTE_AUTO_APROVAR_LEITURA=1

# Pasta onde os comandos do terminal começam (padrão: a pasta atual)
# AGENTE_DIR=C:\Users\voce\Documentos
