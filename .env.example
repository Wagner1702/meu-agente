# Copie para .env e coloque sua chave (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: pasta onde o agente começa (padrão: a pasta onde você rodou o comando)
# AGENTE_DIR=~/Documentos

# Opcional: 1 = roda sem perguntar comandos só de leitura (ls, cat, grep...)
# AGENTE_AUTO_APROVAR_LEITURA=1
